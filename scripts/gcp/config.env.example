# Copy to config.env and adjust (config.env is gitignored).
#   cp scripts/gcp/config.env.example scripts/gcp/config.env

PROJECT_ID=days-search-app
REGION=us-central1

# Artifact Registry Docker repository (must start with a letter, not a digit).
REPO=na21days-media

# Cloud Run service name.
SERVICE=na21days-media-api

# GCS bucket for Chroma persistence (must be globally unique).
BUCKET=na21days-media-chroma-days-search-app

# Runtime service account (short name; full email is derived).
RUNTIME_SA_NAME=na21days-media-run

# Secret Manager secret IDs (not the secret values).
SECRET_OPENAI=openai-api-key
SECRET_YOUTUBE=youtube-api-key
SECRET_ADMIN=admin-api-key

# Cloud Run resource limits (used by deploy.sh).
RUN_MEMORY=1Gi
RUN_TIMEOUT=300
RUN_MAX_INSTANCES=3
RUN_MIN_INSTANCES=0

# Local paths to API key files (relative to project root).
OPENAI_KEY_FILE=openai_api_key.txt
YOUTUBE_KEY_FILE=api_key.txt

# Chroma mount path inside the container.
CHROMA_MOUNT_PATH=/mnt/chroma_data

# Video card debug fields (timestamp, confidence, hashtags). Deploy sets false.
# Locally leave unset or true to show them during testing.
# SHOW_RESULT_DEBUG=true
